# ─── Supabase (injetado pela integração Supabase ↔ Vercel; local: `vercel env pull .env.local`) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # só servidor. NUNCA com prefixo NEXT_PUBLIC_

# ─── Asaas ───
# Sandbox: https://api-sandbox.asaas.com (chave começa com $aact_hmlg_)
# Produção: https://api.asaas.com (chave começa com $aact_)  — SEM o sufixo /v3
ASAAS_API_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=                  # mesmo valor cadastrado no painel Asaas > Integrações > Webhooks

# ─── Loja ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=5561998894889
CRON_SECRET=                          # protege /api/cron/*

# ─── E-mail (liga quando houver domínio verificado) ───
RESEND_API_KEY=
EMAIL_FROM="Juliana Cestas <pedidos@exemplo.com.br>"

# ─── Plataforma multi-tenant (vazio = loja única, comportamento atual) ───
# Domínio da plataforma (landing, cadastro, super admin). Ex.: minhaplataforma.com.br
PLATFORM_DOMAIN=
# URL pública da plataforma (webhooks e links fora de um host de loja)
PLATFORM_PUBLIC_URL=
# Loja usada quando o host não identifica nenhuma (dev, previews, hosts legados)
DEFAULT_TENANT_SLUG=juliana-cestas
# Rede de segurança: resolve host -> loja SEM consultar o banco
LEGACY_HOST_TENANT_JSON={"julianacesta.com.br":{"id":"a0000000-0000-4000-8000-000000000001","slug":"juliana-cestas"},"www.julianacesta.com.br":{"id":"a0000000-0000-4000-8000-000000000001","slug":"juliana-cestas"},"juliana-cestas-loja.vercel.app":{"id":"a0000000-0000-4000-8000-000000000001","slug":"juliana-cestas"}}

# ─── Operação / testes (só local, nunca na Vercel) ───
# Connection string do Postgres, usada por `npm run backup` antes de migração
SUPABASE_DB_URL=
# Credenciais da 2ª loja para `npm run test:isolation` (ver supabase/seeds/dev_tenant.sql)
ISOLATION_STAFF_B_EMAIL=
ISOLATION_STAFF_B_PASSWORD=
ISOLATION_TENANT_A_ID=a0000000-0000-4000-8000-000000000001
